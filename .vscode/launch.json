{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "后端：FastAPI（调试）",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "env": {
        "CLOUD_DEVICE_BACKEND": "simulator",
        "CLOUD_DEBUG": "true"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "后端：pytest（全部）",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["tests", "-q"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "后端：pytest（当前文件）",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q", "${file}"],
      "cwd": "${workspaceFolder}/backend",
      "console": "integratedTerminal",
      "justMyCode": false
    },
    {
      "name": "前端：Vite Dev",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["run", "dev", "--", "--host", "127.0.0.1"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ],
  "compounds": [
    {
      "name": "全栈：后端 + 前端",
      "configurations": ["后端：FastAPI（调试）", "前端：Vite Dev"],
      "stopAll": true
    }
  ]
}
