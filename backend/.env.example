# ===== 云手机平台本地开发配置 =====
# 复制本文件为 .env，然后修改 ADB 路径为你本机的实际路径

# 设备后端类型：redroid（云手机容器）/ physical（纳管真实手机）/ simulator（离线演示）
CLOUD_DEVICE_BACKEND=redroid
# 实体机模式：手机开启 USB 调试并连到本机 adb server（无线调试先执行 adb connect）
# 平台只记录设备原值并支持 QA 重置（清应用数据+重启），不会修改 IMEI/序列号/Android ID
# CLOUD_DEVICE_BACKEND=physical

# 共享 PostgreSQL（团队协作模式，所有成员数据实时同步）
# 请替换 <DB_USER> / <DB_PASSWORD> / <DB_HOST> / <DB_NAME> 为你自己的库信息
CLOUD_DATABASE_URL=postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>
# 如需要切回本地 SQLite（离线/单机模式），改为下面这行并删除 cloud_platform.db 后重启：
# CLOUD_DATABASE_URL=sqlite+aiosqlite:///./cloud_platform.db

# 运行模式：debug=false 时，若仍使用默认 JWT 密钥/管理员口令会拒绝启动
CLOUD_DEBUG=true

# JWT 配置（生产必须改成随机长字符串，例如 openssl rand -hex 32）
CLOUD_JWT_SECRET=change-me-in-production-please
CLOUD_JWT_EXPIRE_MINUTES=720

# 管理员账号（仅演示默认值 admin/admin123，生产必须改）
CLOUD_ADMIN_USERNAME=admin
CLOUD_ADMIN_PASSWORD=admin123

# 安全相关（可选）
# 单条 adb 命令超时秒数，防止 adb 挂死耗尽线程池
# CLOUD_ADB_TIMEOUT=15
# 批量操作同时下发的设备数上限
# CLOUD_BATCH_CONCURRENCY=8
# 一键新机并发（每台要删容器/清数据/重建/等开机，建议 1-3）
# CLOUD_RENEW_CONCURRENCY=2
# APK 下载地址主机白名单（为空则允许任意 http/https）
# CLOUD_APK_URL_ALLOW_HOSTS='["download.example.com"]'
# CORS 允许来源（生产建议显式列出，不要用 *）
# CLOUD_CORS_ORIGINS='["http://localhost:5173","https://your-domain"]'
# 日志级别（DEBUG/INFO/WARNING/ERROR，默认 INFO）
# CLOUD_LOG_LEVEL=INFO

# Redroid GPU 模式
CLOUD_REDROID_GPU_MODE=guest

# ===== 以下两项需要根据你本机环境修改 =====

# 远程服务器地址（Redroid 宿主机，填写你自己的地址）
CLOUD_REDROID_HOST=<REDROID_HOST>

# 你本机的 ADB 路径（改为你实际安装的位置）
# Windows 示例: D:\\platform-tools\\adb.exe
# macOS 示例:   /usr/local/bin/adb
# Linux 示例:   /usr/bin/adb
CLOUD_ADB_PATH=D:\\platform-tools\\adb.exe

# Docker 远程 API（指向同一台服务器）
DOCKER_HOST=tcp://<REDROID_HOST>:2375

# ===== 以下配置仅在切回 SQLite 时需要 =====

# 预置团队用户（仅 SQLite 模式需要，PostgreSQL 模式直接在 Web 页面管理用户）
# CLOUD_SEED_USERS='[{"username":"<USERNAME>","password":"<PASSWORD>","role":"operator"}]'

# 设备同步（仅 SQLite 模式需要，PostgreSQL 模式直读同一数据库无需同步）
# CLOUD_SYNC_SERVER=http://<SYNC_HOST>:8000/api
# CLOUD_SYNC_INTERVAL=30
# 同步账号（仅演示默认值，实际部署请换成你自己的中心服务器账号）
# CLOUD_SYNC_USERNAME=admin
# CLOUD_SYNC_PASSWORD=admin123

# ===== 本地改代码口令门禁（tools/code_auth.py 读取；真实口令放本地 .env，不入库）=====
CODE_AUTH_PASSWORD=<your-own-password>

# ===== RBAC 初始账号口令（python tools/seed_rbac.py 读取）=====
# 留空则脚本用 secrets 生成强口令，并写入本地未跟踪文件 .seed_passwords.json
CLOUD_SEED_PWD_SUPERADMIN=<your-superadmin-password>
CLOUD_SEED_PWD_ADMIN=<your-admin-password>
CLOUD_SEED_PWD_OPERATOR=<your-operator-password>
CLOUD_SEED_PWD_VIEWER=<your-viewer-password>

# ===== CORS（JSON 数组；默认只放行 http://localhost:5173 / 4173）=====
# 生产按实际域名填写，不要用 "*"
# CLOUD_CORS_ORIGINS=["https://your-domain.example.com"]
